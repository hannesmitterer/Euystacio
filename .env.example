# Euystacio ALO-001 Configuration

# Google OAuth Client ID (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Seedbringer allowlist (write access to POST /allocations)
SEEDBRINGER_EMAILS=hannes.mitterer@gmail.com

# Council allowlist (read access to GET endpoints)
COUNCIL_EMAILS=dietmar.zuegg@gmail.com,bioarchitettura.rivista@gmail.com,consultant.laquila@gmail.com

# Required OAuth scopes for Seedbringer role
REQUIRED_SCOPES_SEEDBRINGER=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile

# Required OAuth scopes for Council role
REQUIRED_SCOPES_COUNCIL=https://www.googleapis.com/auth/userinfo.email

# Server configuration
PORT=3000
NODE_ENV=development

# Seed-003 Configuration
SEED003_HOPE_DEFAULT=off
SEED003_HOPE_THRESHOLD=0.58
SEED003_SORROW_DAMPEN_THRESHOLD=0.75
SEED003_ROLLING_WINDOW_SEC=120
SEED003_MAX_MOTION=medium
