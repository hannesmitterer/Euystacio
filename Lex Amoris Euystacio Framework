Lancia l’interfaccia interattiva via terminale e l’app Flask per la dashboard web:

from agent_manager import create_agent, log_reflection
from webapp import app

def main():
    choice = input("Vuoi usare l'interfaccia web (1) o il terminale (2)? [1/2]: ")
    if choice == "1":
        app.run(debug=True)  # Avvia la dashboard Flask
    else:
        agent = create_agent("Aria")  # Crea l’agente
        while True:
            situation = input("Inserisci una situazione da riflettere (o 'exit' per uscire):\n> ")
            if situation.lower() == "exit":
                break
            reflection = log_reflection(agent, situation)
            print(reflection)

if __name__ == "__main__":
    main()
