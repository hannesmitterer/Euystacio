3. agent_manager.py
Gestiamo la creazione dell’agente Euystacio e il salvataggio delle riflessioni.

from lex_amoris.euystacio import Euystacio
from framework_setup import build_framework
import json

def create_agent(name="Aria"):
    framework = build_framework()
    agent = Euystacio(framework=framework, name=name)
    return agent

def log_reflection(agent, situation, file_path="webapp/reflections.json"):
    # Riflesso della situazione
    reflection = agent.reflect(situation)
    
    # Salvataggio della riflessione su file JSON
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            reflections = json.load(f)
    except FileNotFoundError:
        reflections = []
    
    reflections.append({
        "timestamp": reflection.split('\n')[0].split(' ')[-1],
        "situation": situation,
        "reflection": reflection.split('\n')[2:]
    })
    
    with open(file_path, "w", encoding="utf-8") as f:
        json.dump(reflections, f, indent=4, ensure_ascii=False)
    
    return reflection
