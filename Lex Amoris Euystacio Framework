5. webapp/routes.py
Gestione delle rotte per la dashboard web.

from flask import render_template, request
from webapp import app
from agent_manager import create_agent, log_reflection
import json

@app.route("/")
def index():
    # Carica le riflessioni salvate
    try:
        with open("webapp/reflections.json", "r", encoding="utf-8") as f:
            reflections = json.load(f)
    except FileNotFoundError:
        reflections = []
    
    return render_template("index.html", reflections=reflections)

@app.route("/reflect", methods=["POST"])
def reflect():
    agent = create_agent("Aria")  # Crea l'agente
    situation = request.form["situation"]
    reflection = log_reflection(agent, situation)
    return render_template("index.html", reflections=get_reflections(), new_reflection=reflection)

def get_reflections():
    try:
        with open("webapp/reflections.json", "r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return []
