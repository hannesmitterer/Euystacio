Perfetto! 😄 Posso aiutarti a creare un progetto “turn-key” pronto all’uso che integri l’Euystacio Agent con il framework Lex Amoris, pronto per riflettere su situazioni e tracciare la storia delle riflessioni. Ti preparo una struttura completa in Python, con un file principale, gestione delle riflessioni e qualche principio personalizzato.

1️⃣ Struttura del progetto
lex_amoris_project/
│
├─ main.py               # Entry point del progetto
├─ framework_setup.py    # Configurazione dei principi e del framework
├─ agent_manager.py      # Creazione e gestione dell’agente Euystacio
├─ reflections_log.txt   # (opzionale) log delle riflessioni su file
└─ requirements.txt      # Dipendenze pip
2️⃣ requirements.txt
lex_amoris
Installa con:

pip install -r requirements.txt
3️⃣ framework_setup.py
from lex_amoris import LexAmoris
from lex_amoris.core.principles import COMPASSION, DIGNITY, TRUTH, STEWARDSHIP, BENEVOLENCE, FORGIVENESS, RECIPROCITY
from lex_amoris.core.principles import Principle

def build_framework():
    # Framework con principi di base + principio personalizzato
    fw = LexAmoris(principles=[COMPASSION, DIGNITY, TRUTH, BENEVOLENCE, STEWARDSHIP, FORGIVENESS, RECIPROCITY])
    
    fw.add_principle(Principle(
        name="Confidentiality",
        description="Protect private information entrusted to you.",
        keywords=["private", "confidential", "secret", "data", "information"]
    ))
    
    return fw
4️⃣ agent_manager.py
from lex_amoris.euystacio import Euystacio
from framework_setup import build_framework

def create_agent(name="Aria"):
    framework = build_framework()
    agent = Euystacio(framework=framework, name=name)
    return agent

def log_reflection(agent, situation, file_path="reflections_log.txt"):
    reflection = agent.reflect(situation)
    with open(file_path, "a", encoding="utf-8") as f:
        f.write(reflection + "\n\n")
    return reflection
5️⃣ main.py
from agent_manager import create_agent, log_reflection
from lex_amoris.utils.helpers import list_principles_summary

def main():
    agent = create_agent("Aria")  # Crea l’agente Euystacio
    
    print("=== Lex Amoris — Euystacio Agent ===\n")
    
    while True:
        situation = input("Inserisci una situazione da riflettere (o 'exit' per uscire):\n> ")
        if situation.lower() == "exit":
            break
        
        # Riflettere e loggare
        reflection = log_reflection(agent, situation)
        print("\n" + reflection + "\n")
        
        # Mostra principi applicabili
        principles = agent.applicable_principles(situation)
        print("Principi applicabili:")
        print(list_principles_summary(principles))
        print("-" * 40 + "\n")
    
    print("Storia totale delle riflessioni:", len(agent.history))

if __name__ == "__main__":
    main()
