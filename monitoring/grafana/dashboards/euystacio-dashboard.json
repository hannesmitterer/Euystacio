{
  "dashboard": {
    "id": null,
    "uid": "euystacio-monitoring",
    "title": "Euystacio - Real-time Monitoring Dashboard",
    "tags": ["euystacio", "monitoring", "security"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Node Status",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "{job=\"node-status\"}",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "Loki"
            }
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 2,
        "title": "System Latency",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 9,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate({job=\"euystacio-app\"}[5m])",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "Loki"
            }
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": null,
            "logBase": 1,
            "max": null,
            "min": null,
            "show": true
          }
        ]
      },
      {
        "id": 3,
        "title": "Intrusion Detection Alerts",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 9,
          "x": 15,
          "y": 0
        },
        "targets": [
          {
            "expr": "{job=\"intrusion\"}",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "Loki"
            }
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "Time",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 4,
        "title": "Application Logs",
        "type": "logs",
        "gridPos": {
          "h": 12,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "{job=\"euystacio-app\"}",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "Loki"
            }
          }
        ],
        "options": {
          "showLabels": true,
          "showTime": true,
          "wrapLogMessage": true,
          "sortOrder": "Descending",
          "dedupStrategy": "none",
          "enableLogDetails": true
        }
      },
      {
        "id": 5,
        "title": "Security Events",
        "type": "logs",
        "gridPos": {
          "h": 12,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "{job=\"security\"}",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "Loki"
            }
          }
        ],
        "options": {
          "showLabels": true,
          "showTime": true,
          "wrapLogMessage": true,
          "sortOrder": "Descending",
          "dedupStrategy": "none",
          "enableLogDetails": true
        }
      },
      {
        "id": 6,
        "title": "Node Health Status",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "up{job=\"euystacio-nodes\"}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "Prometheus"
            }
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 0.5,
                  "color": "yellow"
                },
                {
                  "value": 0.9,
                  "color": "green"
                }
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 7,
        "title": "Log Volume (Messages/sec)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 20
        },
        "targets": [
          {
            "expr": "rate({job=~\".+\"}[1m])",
            "refId": "A",
            "legendFormat": "{{job}}",
            "datasource": {
              "type": "loki",
              "uid": "Loki"
            }
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "messages/sec",
            "logBase": 1,
            "max": null,
            "min": 0,
            "show": true
          }
        ]
      },
      {
        "id": 8,
        "title": "Critical Events Counter",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 20
        },
        "targets": [
          {
            "expr": "count_over_time({job=\"intrusion\", alert_level=\"critical\"}[1h])",
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "Loki"
            }
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["sum"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 10,
                  "color": "red"
                }
              ]
            }
          }
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    }
  },
  "overwrite": true
}
